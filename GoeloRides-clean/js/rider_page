  /* ═══════════════════════════════════════
     TOAST
  ═══════════════════════════════════════ */

  function toast(msg) {
    var el = document.getElementById("toast");
    if (!el) return;

    el.textContent = msg;
    el.style.display = "block";

    clearTimeout(el._t);
    el._t = setTimeout(function () {
      el.style.display = "none";
    }, 2500);
  }

  /* ═══════════════════════════════════════
     CHECKLIST
  ═══════════════════════════════════════ */

  function toggleCheck(el) {
    el.classList.toggle("done");

    var label = el.nextElementSibling;
    if (label) label.classList.toggle("done");

    var tag = label ? label.nextElementSibling : null;
    if (!tag) return;

    if (el.classList.contains("done")) {
      tag.textContent = "OK";
      tag.className = "check-tag tag-ok";
    } else {
      tag.textContent = "À faire";
      tag.className = "check-tag tag-pending";
    }
  }

  /* ═══════════════════════════════════════
     URGENCE MESSAGES
  ═══════════════════════════════════════ */

  var MSGS = {
    retard:
      "⏱ GOËLORIDES — Retard\n\nDépart retardé de 15 min.\nMerci de patienter au point de RDV.",
    annulation:
      "❌ GOËLORIDES — Annulation\n\nSortie annulée pour raisons météo.",
    meteo:
      "🌧 GOËLORIDES — Météo\n\nSortie maintenue malgré météo incertaine.",
    rdv:
      "📍 GOËLORIDES — Nouveau RDV\n\nChangement de point de départ."
  };

  function genUrgence(type, el) {
    var box = el.querySelector(".urgence-result");
    if (!box) return;

    if (box.style.display === "block") {
      box.style.display = "none";
      return;
    }

    box.textContent = MSGS[type] || "";
    box.style.display = "block";

    if (navigator.clipboard) {
      navigator.clipboard.writeText(box.textContent);
      toast("Message copié");
    }
  }

  function openUrgence() {
    var sec = document.getElementById("urgence-section");
    if (sec) sec.scrollIntoView({ behavior: "smooth" });

    toast("Choisis un message d’urgence");
  }

  /* ═══════════════════════════════════════
     DEMANDES TEAM RIDER
  ═══════════════════════════════════════ */

  function approveDemand(btn) {
    var card = btn.closest(".demand-card");
    if (!card) return;

    card.querySelector(".demand-actions").innerHTML =
      '<span style="color:#4ade80;font-size:11px">✓ Approuvée</span>';

    toast("Accès accordé");
  }

  function refuseDemand(btn) {
    var card = btn.closest(".demand-card");
    if (!card) return;

    card.querySelector(".demand-actions").innerHTML =
      '<span style="color:#f87171;font-size:11px">✕ Refusée</span>';

    toast("Demande refusée");
  }

  /* ═══════════════════════════════════════
     FILTER SORTIES (UI ONLY)
  ═══════════════════════════════════════ */

  function filterSorties(type, btn) {
    document.querySelectorAll(".stab").forEach(function (b) {
      b.classList.remove("active");
    });

    btn.classList.add("active");

    document.querySelectorAll(".sortie-row").forEach(function (row) {
      if (type === "all") {
        row.style.display = "flex";
      } else {
        row.style.display = row.dataset.s === type ? "flex" : "none";
      }
    });
  }

  /* ═══════════════════════════════════════
     CLIPBOARD
  ═══════════════════════════════════════ */

  function copy(text) {
    if (!navigator.clipboard) return;
    navigator.clipboard.writeText(text);
    toast("Copié");
  }

  /* ═══════════════════════════════════════
     INIT
  ═══════════════════════════════════════ */

  document.addEventListener("DOMContentLoaded", function () {
    window.toggleCheck = toggleCheck;
    window.genUrgence = genUrgence;
    window.openUrgence = openUrgence;
    window.approveDemand = approveDemand;
    window.refuseDemand = refuseDemand;
    window.filterSorties = filterSorties;
    window.copy = copy;

    toast("Team Rider Dashboard prêt");
  });
})()

