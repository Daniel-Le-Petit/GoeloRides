# Copier vers .env.backup à la racine du dépôt (fichier ignoré par git).
# Ne jamais committer .env.backup.

# Supabase → Settings → Database → Connection string → URI (session mode / direct, port 5432).
# Ajouter sslmode=require si besoin.
SUPABASE_DATABASE_URL=postgresql://postgres:CHANGER@db.xxxxx.supabase.co:5432/postgres

# Cloudflare R2 → Manage R2 API Tokens (S3-compatible).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=goelorides-backups

# Préfixe des clés objet (dossier logique dans le bucket). Défaut si vide : backups/goelorides-
# R2_PREFIX=backups/goelorides-

# Restore uniquement : URL de la base où importer (staging / clone), pas la prod sans validation.
# TARGET_DATABASE_URL=postgresql://postgres:...@db....supabase.co:5432/postgres
